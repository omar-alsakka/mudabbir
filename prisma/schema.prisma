generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  passwordHash   String
  avatarUrl      String?
  preferredLang  String    @default("en")
  preferredTheme String    @default("dark")
  baseCurrency   String    @default("USD")
  hourlyRate     Decimal?  @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  wallets            Wallet[]
  transactions       Transaction[]
  budgets            Budget[]
  savingsGoals       SavingsGoal[]
  debts              Debt[]
  subscriptions      Subscription[]
  shoppingListItems  ShoppingListItem[]
  customCategories   Category[]
  quickShortcuts     QuickShortcut[]
  auditLogs          AuditLog[]
  exchangeRates      UserExchangeRate[]
  savingsChallenges  SavingsChallenge[]
  accounts           Account[]
  sessions           Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

enum WalletType {
  CASH
  BANK_ACCOUNT
}

model Wallet {
  id         String     @id @default(cuid())
  userId     String
  name       String
  nameAr     String?
  type       WalletType
  currency   String     @default("USD")
  color      String     @default("#3B82F6")
  icon       String?
  isArchived Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelopes    Envelope[]
  transactions Transaction[]

  @@index([userId])
  @@map("wallets")
}

model Envelope {
  id              String   @id @default(cuid())
  walletId        String
  name            String
  nameAr          String?
  icon            String?
  allocatedAmount Decimal  @default(0) @db.Decimal(14, 2)
  currentBalance  Decimal  @default(0) @db.Decimal(14, 2)
  color           String   @default("#10B981")
  isDefault       Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  wallet        Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  transfersFrom EnvelopeTransfer[] @relation("TransferFrom")
  transfersTo   EnvelopeTransfer[] @relation("TransferTo")

  @@index([walletId])
  @@map("envelopes")
}

model EnvelopeTransfer {
  id             String   @id @default(cuid())
  fromEnvelopeId String
  toEnvelopeId   String
  amount         Decimal  @db.Decimal(14, 2)
  note           String?
  createdAt      DateTime @default(now())

  fromEnvelope Envelope @relation("TransferFrom", fields: [fromEnvelopeId], references: [id])
  toEnvelope   Envelope @relation("TransferTo", fields: [toEnvelopeId], references: [id])

  @@map("envelope_transfers")
}

enum CategoryType {
  INCOME
  EXPENSE
  TRANSFER
}

model Category {
  id        String       @id @default(cuid())
  userId    String?
  name      String
  nameAr    String?
  icon      String?
  type      CategoryType @default(EXPENSE)
  parentId  String?
  isSystem  Boolean      @default(false)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        Category?      @relation("SubCategories", fields: [parentId], references: [id])
  children      Category[]     @relation("SubCategories")
  picklistItems PicklistItem[]
  transactions  Transaction[]
  budgets       Budget[]

  @@index([userId])
  @@map("categories")
}

model PicklistItem {
  id           String   @id @default(cuid())
  categoryId   String
  name         String
  nameAr       String?
  icon         String?
  defaultPrice Decimal? @db.Decimal(12, 2)
  sortOrder    Int      @default(0)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@map("picklist_items")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model Transaction {
  id           String          @id @default(cuid())
  userId       String
  walletId     String
  envelopeId   String?
  categoryId   String?
  type         TransactionType
  amount       Decimal         @db.Decimal(14, 2)
  currency     String          @default("USD")
  exchangeRate Decimal?        @db.Decimal(14, 6)
  description  String?
  notes        String?
  date         DateTime        @default(now())
  isRecurring  Boolean         @default(false)
  recurringId  String?

  picklistItems Json?   @db.JsonB
  tags          String[]

  happinessRating Int? @db.SmallInt

  receiptUrl      String?
  receiptMimeType String?
  warrantyExpiry  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet       Wallet            @relation(fields: [walletId], references: [id])
  envelope     Envelope?         @relation(fields: [envelopeId], references: [id])
  category     Category?         @relation(fields: [categoryId], references: [id])
  recurringDef RecurringExpense? @relation(fields: [recurringId], references: [id])

  splitBillId String?
  splitBill   SplitBill? @relation(fields: [splitBillId], references: [id])

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([walletId])
  @@index([envelopeId])
  @@index([tags], type: Gin)
  @@map("transactions")
}

model Budget {
  id           String   @id @default(cuid())
  userId       String
  categoryId   String?
  name         String
  nameAr       String?
  amount       Decimal  @db.Decimal(14, 2)
  spent        Decimal  @default(0) @db.Decimal(14, 2)
  period       String   @default("monthly")
  startDate    DateTime
  endDate      DateTime
  isZeroBased  Boolean  @default(false)
  templateName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([userId, startDate, endDate])
  @@map("budgets")
}

model RecurringExpense {
  id          String   @id @default(cuid())
  userId      String
  name        String
  nameAr      String?
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @default("USD")
  frequency   String
  nextDueDate DateTime
  walletId    String?
  envelopeId  String?
  categoryId  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  transactions Transaction[]

  @@map("recurring_expenses")
}

model Subscription {
  id           String   @id @default(cuid())
  userId       String
  name         String
  nameAr       String?
  amount       Decimal  @db.Decimal(14, 2)
  currency     String   @default("USD")
  billingCycle String
  renewalDate  DateTime
  icon         String?
  url          String?
  isActive     Boolean  @default(true)
  alertDays    Int      @default(3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

model SavingsGoal {
  id            String    @id @default(cuid())
  userId        String
  name          String
  nameAr        String?
  targetAmount  Decimal   @db.Decimal(14, 2)
  currentAmount Decimal   @default(0) @db.Decimal(14, 2)
  currency      String    @default("USD")
  icon          String?
  color         String    @default("#8B5CF6")
  deadline      DateTime?
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("savings_goals")
}

model SavingsChallenge {
  id          String    @id @default(cuid())
  userId      String
  type        String
  name        String
  startDate   DateTime
  endDate     DateTime?
  progress    Json      @db.JsonB
  isActive    Boolean   @default(true)
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("savings_challenges")
}

enum DebtDirection {
  I_OWE
  OWED_TO_ME
}

model Debt {
  id              String        @id @default(cuid())
  userId          String
  personName      String
  direction       DebtDirection
  totalAmount     Decimal       @db.Decimal(14, 2)
  remainingAmount Decimal       @db.Decimal(14, 2)
  currency        String        @default("USD")
  description     String?
  dueDate         DateTime?
  isSettled       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments DebtPayment[]

  @@index([userId])
  @@map("debts")
}

model DebtPayment {
  id     String   @id @default(cuid())
  debtId String
  amount Decimal  @db.Decimal(14, 2)
  date   DateTime @default(now())
  note   String?

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@map("debt_payments")
}

model SplitBill {
  id          String   @id @default(cuid())
  title       String
  totalAmount Decimal  @db.Decimal(14, 2)
  currency    String   @default("USD")
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  participants SplitBillParticipant[]
  transactions Transaction[]

  @@map("split_bills")
}

model SplitBillParticipant {
  id          String  @id @default(cuid())
  splitBillId String
  name        String
  shareAmount Decimal @db.Decimal(14, 2)
  isPaid      Boolean @default(false)

  splitBill SplitBill @relation(fields: [splitBillId], references: [id], onDelete: Cascade)

  @@map("split_bill_participants")
}

model ShoppingListItem {
  id                 String   @id @default(cuid())
  userId             String
  name               String
  nameAr             String?
  quantity           Int      @default(1)
  estimatedPrice     Decimal? @db.Decimal(12, 2)
  categoryId         String?
  isChecked          Boolean  @default(false)
  convertedToExpense Boolean  @default(false)
  transactionId      String?
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("shopping_list_items")
}

model UserExchangeRate {
  id           String   @id @default(cuid())
  userId       String
  fromCurrency String
  toCurrency   String
  rate         Decimal  @db.Decimal(14, 6)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fromCurrency, toCurrency])
  @@map("user_exchange_rates")
}

model QuickShortcut {
  id         String          @id @default(cuid())
  userId     String
  label      String
  labelAr    String?
  icon       String?
  amount     Decimal         @db.Decimal(14, 2)
  walletId   String?
  envelopeId String?
  categoryId String?
  type       TransactionType @default(EXPENSE)
  sortOrder  Int             @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("quick_shortcuts")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  oldValue   Json?    @db.JsonB
  newValue   Json?    @db.JsonB
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
